# Port the website runs on
PORT=3000

# Optional: only accept connections on this address (install.sh sets 127.0.0.1 when nginx is in front)
# HOST=127.0.0.1

# Everything below is optional. The admin password is created the first time you open /admin,
# and the Yoco key and website address can be entered under Admin > Payments.

# The public address of your website, e.g. https://winbig.co.za
PUBLIC_URL=http://localhost:3000

# Your Yoco SECRET key (starts with sk_test_ or sk_live_). Leave empty to run in DEMO mode.
YOCO_SECRET_KEY=

# Only needed if you set up the Yoco webhook by hand. Starts with whsec_
YOCO_WEBHOOK_SECRET=

# Where the database and prize photos are stored (default: the data folder)
# DATA_DIR=/var/winbig-data
